# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in your values.
# After apply, point your Cloudflare DNS CNAME to the container_app_fqdn output
# and enable the Cloudflare proxy (orange cloud) on that record.
# ─────────────────────────────────────────────────────────────────────────────

# General
prefix              = "myapp"          # 2-15 lowercase alphanumeric / hyphens
location            = "eastus"         # Azure region
resource_group_name = "rg-container-apps"

# Container Registry
acr_sku = "Basic"   # Basic | Standard | Premium

# Application image (pushed to ACR before first deploy)
app_image_name = "api"     # repository name inside ACR
app_image_tag  = "latest"  # pin to a digest or semver tag in production

# Container App sizing
# Valid CPU / memory pairs (per container):
#   0.25 / 0.5Gi  |  0.5 / 1Gi  |  0.75 / 1.5Gi
#   1.0 / 2Gi     |  1.25 / 2.5Gi  | ... up to 4.0 / 8Gi
app_cpu    = 0.5
app_memory = "1Gi"

# Scaling
min_replicas = 1   # set to 0 to enable scale-to-zero (cold starts apply)
max_replicas = 3


