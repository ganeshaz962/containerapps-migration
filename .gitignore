# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform state (contains all resource details including secrets)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
